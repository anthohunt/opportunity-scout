# Réglages du lanceur de l'agent (agent/lancer.sh). Copiez en .env puis : set -a; . ./.env; set +a
SCOUT_DIR=/srv/scout-data              # dossier de données de l'app (le même que le volume monté sur /data)
SCOUT_TZ=Europe/Paris                  # fuseau des heures de passage
SCOUT_HEURE_QUOTIDIEN=07               # heure du passage quotidien
SCOUT_HEURE_HEBDO=08                   # heure du récapitulatif du lundi
SCOUT_CLAUDE_CMD=claude                # commande de l'agent (Claude Code, connecté à un compte)
SCOUT_MODEL=claude-opus-5-5
#SCOUT_WRAPPER=nice                    # préfixe facultatif (limiteur de CPU)
#SCOUT_ENV_FILE=/etc/scout/agent.env   # fichier d'environnement à charger avant l'agent (jetons)
SCOUT_IMPORT_CMD="docker compose exec -T scout python manage.py import"
# Mail du lundi (SMTP). Rien n'est envoyé tant que le fichier $SCOUT_DIR/.envoi-actif n'existe pas.
SCOUT_MAIL_DE=scout@example.org
SCOUT_MAIL_A=vous@example.org
SCOUT_ENVOI_DES=2026-01-19
SMTP_HOTE=smtp.example.org
SMTP_PORT=587
SMTP_UTILISATEUR=scout@example.org
SMTP_MOT_DE_PASSE=
# App : lien affiché dans le mail du lundi
APP_URL=https://scout.example.org
